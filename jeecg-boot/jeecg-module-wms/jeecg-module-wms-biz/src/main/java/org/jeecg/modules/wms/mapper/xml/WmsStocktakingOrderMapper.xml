<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.jeecg.modules.wms.mapper.WmsStocktakingOrderMapper">

    <select id="selectByOrderNo" resultType="org.jeecg.modules.wms.entity.WmsStocktakingOrder">
        SELECT *
        FROM wms_stocktaking_order
        WHERE order_no = #{orderNo}
          AND is_del = 1
        LIMIT 1
    </select>

</mapper>
